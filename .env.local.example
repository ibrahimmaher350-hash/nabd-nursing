# Firebase Configuration — نبض للتمريض المنزلي
# Copy this file to .env.local and fill in your Firebase project values.
# NEVER commit .env.local to version control.

# ─── Firebase Client SDK ─────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Firebase Cloud Messaging ────────────────────────────────
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_web_push_vapid_key_here

# ─── Firebase Admin SDK (Server-side only) ───────────────────
# Used in API routes — NOT exposed to browser
FIREBASE_ADMIN_PROJECT_ID=your_project_id_here
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Analytics & SEO ─────────────────────────────────────────
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_search_console_verification_code
NEXT_PUBLIC_BING_SITE_VERIFICATION=your_bing_webmaster_verification_code
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# ─── Site ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ─── Admin ──────────────────────────────────────────────────
# Admin dashboard protection
ADMIN_SECRET_KEY=your_random_secret_key_here
