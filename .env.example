# ------------------------------------------------------------------------------
# 1. Supabase Backend (قاعدة البيانات والتحقق)
# ------------------------------------------------------------------------------
# من لوحة تحكم Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://obaccodbtcaxjmkaxeye.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# المفتاح السري للخادم فقط (لا تشاركه أبداً):
