# ------------------------------------------------------------------------------
# 2. Google Cloud Integration (تقويم Google وجداول البيانات)
# ------------------------------------------------------------------------------
# من Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# عنوان إعادة التوجيه بعد تسجيل دخول Google:
GOOGLE_REDIRECT_URI=https://nabd-nursing.vercel.app/api/auth/google/callback
# معرف جدول Google Sheets المأخوذ من رابط الشيت بين /d/ و /edit:
GOOGLE_SHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms
# معرف تقويم Google (افتراضياً primary لتقويمك الأساسي):
GOOGLE_CALENDAR_ID=primary

# ------------------------------------------------------------------------------
# 3. Security Keys (مفاتيح التشفير والحماية)
# ------------------------------------------------------------------------------
# مفتاح تشفير متماثل AES-256 (32 بايت / 64 حرف Hex) لتشفير رموز Google في قاعدة البيانات:
