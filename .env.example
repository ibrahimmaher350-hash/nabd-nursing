# ==============================================================================
# NABD NURSING & BLOOD BANK — ENVIRONMENT VARIABLES EXAMPLE (.env.example)
# نموذج ملف الإعدادات البيئية لمنظومة عيادة ونبض للتمريض المنزلي
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Backend (قاعدة البيانات السحابية)
# تجدها في: Supabase -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://obaccodbtcaxjmkaxeye.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_secret_service_role_key      # سرّي جداً لا يشارك

# ------------------------------------------------------------------------------
# 2. Google Cloud Integration (ربط جوجل شيت والتقويم)
# تجدها في: console.cloud.google.com -> Credentials -> OAuth 2.0 Client IDs
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret              # سرّي
GOOGLE_REDIRECT_URI=https://nabd-nursing.vercel.app/api/auth/google/callback
# معرّف جدول جوجل شيت (من الرابط بين /d/ و /edit):
GOOGLE_SHEET_ID=19Xv5QOgi0Qn78Q6ypv6PM7sU74khLEtHy7T49T_vUjo
GOOGLE_CALENDAR_ID=primary

# ------------------------------------------------------------------------------
# 3. Security & Cryptography (مفاتيح الحماية والتشفير)
# ------------------------------------------------------------------------------
# مفتاح تشفير رموز Google في قاعدة البيانات (32-byte hex):
ENCRYPTION_KEY=c3ab8ff13720e8ad9047dd39466b3c8974e592c2fa383d4a3960714caef0c4f2
# مفتاح توقيع روابط الإلغاء والتعديل الآمنة في الإيميل:
JWT_SECRET=nabd-clinic-super-secret-jwt-key-2026-cairo-secure-tokens

# ------------------------------------------------------------------------------
# 4. Resend Email Service (خدمة إرسال إيميلات التذكير)
# تجدها في: resend.com -> API Keys
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="نبض للتمريض المنزلي <onboarding@resend.dev>"
OWNER_EMAIL=ibrahim.maher350@gmail.com
OWNER_NAME="نبض للتمريض"

# ------------------------------------------------------------------------------
# 5. General Platform Settings & Flags
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://nabd-nursing.vercel.app
ADMIN_WHATSAPP_NUMBER=201099667065
USE_MOCK=false
ENABLE_REMINDERS=true
SYNC_INTERVAL_MINUTES=2
